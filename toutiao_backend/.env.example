# 复制为 .env 并填入你自己的本地数据库账号密码（.env 已被 .gitignore 忽略）
# 格式: mysql+aiomysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
ASYNC_DATABASE_URL=mysql+aiomysql://USERNAME:PASSWORD@localhost:3306/news_app?charset=utf8mb4

# JWT 签名密钥（生产环境必须改为随机长字符串，可用 python -c "import secrets; print(secrets.token_hex(32))" 生成）
JWT_SECRET_KEY=your-secret-key-change-in-production
